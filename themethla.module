<?php

use Drupal\Core\Entity\EntityTypeInterface;
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\themethla\Hook\ValidationHooks;

/**
 * Implements hook_entity_bundle_field_info_alter().
 */
#[LegacyHook]
function keryx_entity_bundle_field_info_alter(&$fields, EntityTypeInterface $entity_type, $bundle) {
  return \Drupal::service(ValidationHooks::class)->entityBundleFieldInfoAlter($fields, $entity_type, $bundle);
}
